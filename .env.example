# Copy this file to `.env.local` and fill in real values.
# Step-by-step guide: docs/supabase-setup.md
# Leave the values empty (or don't create .env.local) to run in demo mode.
#
# Variables starting with VITE_ are bundled into the browser code, so they must
# only ever hold PUBLIC values.

# Supabase project URL and PUBLIC key (Publishable key "sb_publishable_..." or the
# legacy "anon public" key). Safe in the browser because Row Level Security
# protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-key

# NEVER put the Supabase secret / service-role key or any AI API key in a VITE_
# variable, or anywhere in this file. The optional AI key is stored as a
# Supabase secret and used only by the study-assistant Edge Function.
# See docs/ai-assistant.md.
