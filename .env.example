# Copy this file to `.env.local` and fill in real values (from Stage 2 onward).
# Variables starting with VITE_ are bundled into the browser code, so they must
# only ever hold PUBLIC values.

# Supabase project URL and the public "anon" key
# (Supabase dashboard -> Project Settings -> API).
# The anon key is safe in the browser because Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# NEVER put the Supabase service-role key or any AI API key in a VITE_ variable.
# Those secrets will live only in server-side functions (Stage 7).
